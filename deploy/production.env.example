# production environment for the shared host. copy to .env.production on the
# server, fill it in, and keep it out of source control
APP_ENV=production

# the host resolver is the only adapter production may run
AUTH_ADAPTER=host

# supplied by whoever runs the host. without an issuer and a key the
# service authenticates nobody, and preflight refuses to deploy it
HOST_JWT_ISSUER=
HOST_JWT_AUDIENCE=
HOST_JWT_ALGORITHM=RS256
HOST_JWT_PUBLIC_KEY=
HOST_JWT_SECRET=
HOST_SUBJECT_CLAIM=sub
# the claim and value that mark a room administrator; both or neither
HOST_OPERATOR_CLAIM=
HOST_OPERATOR_VALUE=

# the name the shared proxy serves this service under
CLAVIS_API_DOMAIN=clavis.anxchywl.dev

# daily database copies kept in /var/backups/clavis
BACKUP_KEEP=14

CORS_ALLOWED_ORIGINS=
API_DOCS_ENABLED=false
REQUEST_BODY_MAX_BYTES=16384
